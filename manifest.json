{
  "manifest_version": 3,
  "name": "CKB Testnet Wallet BETA",
  "version": "1.1",
  "description": "CKB Testnet Wallet. This extension is currently in the Beta testing phase.",
  "icons": {
    "128": "logo_128.png"
  },
  "action": {
    "default_icon": {
      "128": "logo_128.png"
    },
    "default_popup": "popup.html"
  },
  "side_panel": {
    "default_path": "popup.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["storage", "sidePanel", "windows"],
  "host_permissions": ["https://testnet.ckb.dev/*"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["provider-page.js"],
      "matches": ["<all_urls>"]
    }
  ],
  "cross_origin_opener_policy": {
    "value": "same-origin"
  },
  "cross_origin_embedder_policy": {
    "value": "require-corp"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
